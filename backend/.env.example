DB_URL=jdbc:postgresql://localhost:5432/TSF_DB
DB_USERNAME=postgres
DB_PASSWORD=1234
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Optional: create PLATFORM_ADMIN on startup (only if that email does not exist yet)
# APP_BOOTSTRAP_ADMIN_USERNAME=admin@thaishopfun.local
# APP_BOOTSTRAP_ADMIN_PASSWORD=Admin1234!

# --- Local testing only: return OTP code / resetToken in API responses (never true in production)
OTP_EXPOSE_CODE=false

# --- Notification delivery (OTP + password reset). Leave MAIL_HOST blank to only log e-mails.
# brevo | smtp | log (blank = brevo when BREVO_API_KEY is set, else smtp when MAIL_HOST is set, otherwise log)
# Railway Free/Trial/Hobby block outbound SMTP -> use brevo in production there.
NOTIFICATION_EMAIL_PROVIDER=
# Link in the reset-password e-mail = APP_FRONTEND_URL + APP_RESET_PASSWORD_PATH + ?token=...
APP_FRONTEND_URL=http://localhost:5173
APP_RESET_PASSWORD_PATH=/reset-password

# SMTP (examples - fill in your own values, never commit real secrets)
#   Gmail:        MAIL_HOST=smtp.gmail.com     MAIL_PORT=587 MAIL_USERNAME=you@gmail.com MAIL_PASSWORD=<16-char app password>
#   SendGrid:     MAIL_HOST=smtp.sendgrid.net  MAIL_PORT=587 MAIL_USERNAME=apikey        MAIL_PASSWORD=<SendGrid API key>
#   Company SMTP: MAIL_HOST=smtp.company.co.th MAIL_PORT=587 (or 465 with MAIL_SSL=true MAIL_STARTTLS=false)
#   Local fake:   MAIL_HOST=localhost          MAIL_PORT=1025 MAIL_STARTTLS=false (no username/password)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender address (must be verified/allowed by the provider). Blank = MAIL_USERNAME if it is an e-mail.
MAIL_FROM=
MAIL_FROM_NAME=ThaiShopFun
MAIL_STARTTLS=true
MAIL_SSL=false

# Brevo HTTP API (NOTIFICATION_EMAIL_PROVIDER=brevo): API key from Brevo > SMTP & API > API keys.
# MAIL_FROM must be a sender verified in Brevo. Never commit the real key.
BREVO_API_KEY=
# BREVO_API_URL=https://api.brevo.com

# SMS: log (default, sends nothing - only logs the masked phone). Real gateways (ThaiBulkSMS, Twilio) not implemented yet.
SMS_PROVIDER=log

# --- Social login (leave blank to keep Google/Facebook buttons disabled)
# Google Cloud Console → OAuth 2.0 Web client ID (also set VITE_OAUTH_GOOGLE_CLIENT_ID on the frontend)
OAUTH_GOOGLE_CLIENT_ID=
# Meta Developer app ID + secret (also set VITE_OAUTH_FACEBOOK_APP_ID)
OAUTH_FACEBOOK_APP_ID=
OAUTH_FACEBOOK_APP_SECRET=
