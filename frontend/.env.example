VITE_API_URL=http://localhost:8081

# Social login client IDs (leave blank to keep buttons disabled; must match backend OAUTH_* values)
VITE_OAUTH_GOOGLE_CLIENT_ID=
VITE_OAUTH_FACEBOOK_APP_ID=

# Feature flags (set "true" only when the backend endpoint exists)
# false — CheckoutRequest has no termsVersion
VITE_FF_TERMS_VERSION_API=false
# false — CheckoutRequest has no shippingAddressId
VITE_FF_ADDRESS_ID_CHECKOUT=false
# false — no GET /api/checkout/shipping-coverage
VITE_FF_SHIPPING_COVERAGE_API=false
# false — no GET /api/orders/{id}/delivery-estimate
VITE_FF_DELIVERY_ESTIMATE_API=false
# true — GET .../orders?paymentMethod&carrierCode&hasTracking&tag&customer
VITE_FF_ORDER_FILTERS_API=true
# true — PATCH .../orders/{id}/internal-note
VITE_FF_ORDER_NOTES_API=true
# true — /order-tags CRUD + PUT .../orders/{id}/tags
VITE_FF_ORDER_TAGS_API=true
# true — POST .../orders/bulk/{action} (+ /tags)
VITE_FF_BULK_ORDERS_API=true
# Merchant header notification feed (MerchantBell)
VITE_FF_MERCHANT_NOTIFICATIONS_API=true
